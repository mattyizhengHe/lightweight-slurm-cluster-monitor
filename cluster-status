def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--clusters", nargs="+", default=DEFAULT_CLUSTERS)
    ap.add_argument("--accounts", nargs="+", default=DEFAULT_ACCOUNTS)
    ap.add_argument("--html", metavar="PATH", help="also write a static HTML snapshot")
    ap.add_argument("--watch", type=int, metavar="SECONDS", help="refresh in a loop")
    ap.add_argument("--history-hours", type=float, default=3.0, help="trace window (default 3h)")
    ap.add_argument("--no-record", action="store_true", help="don't log this run into the trace history")
    args = ap.parse_args()

    def one_pass():
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(args.clusters)) as ex:
            statuses = list(ex.map(lambda h: fetch_cluster(h, args.accounts), args.clusters))
        statuses.sort(key=_cluster_load, reverse=True)
        if not args.no_record:
            record_history(*_grand_totals(statuses))
        print(render_text(statuses, args.accounts, args.history_hours))
        if args.html:
            with open(args.html, "w") as f:
                f.write(render_html(statuses, args.accounts, args.history_hours))
            print(f"\n  wrote {args.html}")

    if args.watch:
        try:
            while True:
                print("\033[H\033[J", end="")  # clear screen
                one_pass()
                time.sleep(args.watch)
        except KeyboardInterrupt:
            sys.exit(0)
    else:
        one_pass()


if __name__ == "__main__":
    main()
